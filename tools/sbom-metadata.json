      "license": "MIT",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "Linux SPI userspace HAL static library (libspihal.a). Includes SpiDriver (spidev ioctl interface) and KernelSpiDriver (custom kernel module ioctl interface). Uses syslog for logging, fcntl/unistd for device file access."
    },
    {
      "spdx_id": "SPDXRef-Package-i2chal",
      "bom_ref": "pkg:github/asiball/private-test-cpp-project@1.1.0#i2c-hal",
      "name": "i2chal",
      "version": "1.1.0",
      "cdx_type": "library",
      "supplier": "asiball",
      "download_location": "git+https://github.com/asiball/private-test-cpp-project.git#i2c-hal",
      "license": "MIT",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "Linux I2C userspace HAL static library (libi2chal.a). I2cDriver wraps i2c-dev (ioctl I2C_SLAVE / I2C_RDWR for repeated-start register reads). Independent of spi-hal; uses common/logger.hpp for logging."
    },
    {
      "spdx_id": "SPDXRef-Package-gpio",
      "bom_ref": "pkg:github/asiball/private-test-cpp-project@1.1.0#gpio",
      "name": "gpio",
      "version": "1.1.0",
      "cdx_type": "library",
      "supplier": "asiball",
      "download_location": "git+https://github.com/asiball/private-test-cpp-project.git#gpio",
      "license": "MIT",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "GPIO edge-interrupt static library (libgpio.a). GpioLine uses the Linux GPIO character device v2 uABI (GPIO_V2_GET_LINE_IOCTL) and waits for edge events with epoll. No external dependency (no libgpiod)."
    },
    {
      "spdx_id": "SPDXRef-Package-ads1115",
      "bom_ref": "pkg:github/asiball/private-test-cpp-project@1.1.0#libsensor-ads1115",
      "name": "ads1115",
      "version": "1.1.0",
      "cdx_type": "library",
      "supplier": "asiball",
      "download_location": "git+https://github.com/asiball/private-test-cpp-project.git#libsensor",
      "license": "MIT",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "ADS1115 sensor shared library (libads1115.so). High-level Ads1115 class providing read_raw / read_voltage over ADS1115 (4ch / 16bit I2C ADC). PIMPL idiom, dependency injection on II2cDriver. Built only when i2c-hal is present."
    },
    {
      "spdx_id": "SPDXRef-Package-my-spi-driver",
      "bom_ref": "pkg:github/asiball/private-test-cpp-project@1.1.0#kernel",
      "name": "my-spi-driver",
      "version": "1.1.0",
      "cdx_type": "firmware",
      "supplier": "asiball",
      "download_location": "git+https://github.com/asiball/private-test-cpp-project.git#kernel",
      "license": "GPL-2.0-only",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "Linux kernel SPI device driver module (my_spi_driver.ko). Registers with Linux SPI subsystem via probe(), exposes /dev/my_spi_dev character device, controlled via MY_SPI_IOC_CONFIG/MY_SPI_IOC_TRANSFER ioctl. Requires running Linux kernel with SPI subsystem enabled."
    },
    {
      "spdx_id": "SPDXRef-Package-libsensor",
      "bom_ref": "pkg:github/asiball/private-test-cpp-project@1.1.0#libsensor",
      "name": "libsensor",
      "version": "1.1.0",
      "cdx_type": "library",
      "supplier": "asiball",
      "download_location": "git+https://github.com/asiball/private-test-cpp-project.git#libsensor",
      "license": "MIT",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "MCP3008 sensor shared library (libsensor.so). High-level Sensor class providing read_raw / read_voltage / read_raw_async over MCP3008 (8ch / 10bit SPI ADC). PIMPL idiom, dependency injection on ISpiDriver."
    },
    {
      "spdx_id": "SPDXRef-Package-libadxl345",
      "bom_ref": "pkg:github/asiball/private-test-cpp-project@1.1.0#libadxl345",
      "name": "libadxl345",
      "version": "1.1.0",
      "cdx_type": "library",
      "supplier": "asiball",
      "download_location": "git+https://github.com/asiball/private-test-cpp-project.git#libadxl345",
      "license": "MIT",
      "copyright": "Copyright (c) 2024 asiball",
      "description": "ADXL345 accelerometer shared library (libadxl345.so). High-level Adxl345 class providing register-map access (read_reg / write_reg / update_bits) and read_raw / read_g over ADXL345 (3-axis SPI accelerometer). Register-type device example contrasting MCP3008. PIMPL idiom, dependency injection on ISpiDriver; static-links spi-hal."
    },
