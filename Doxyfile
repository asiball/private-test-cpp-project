# ──────────────────────────────────────────────
# Doxyfile — embedded-device-suite
# 生成: doxygen Doxyfile
# 出力: docs/doxygen/html/index.html
# ──────────────────────────────────────────────

PROJECT_NAME           = "embedded-device-suite"
PROJECT_NUMBER         = "v1.1.0"
PROJECT_BRIEF          = "Linux SPI デバイス制御ライブラリ"
OUTPUT_DIRECTORY       = docs/doxygen

# 解析対象（ヘッダのみで十分。実装コメントも含めるなら src も追加）
INPUT                  = spi-hal/include \
                         i2c-hal/include \
                         gpio/include \
                         libsensor/include \
                         libadxl345/include \
                         libmcp9808/include \
                         common/include \
                         kernel/include \
                         cli/src
RECURSIVE              = YES
# C++ ヘッダ/実装に加え、common(logger) と kernel(C ドライバ) も網羅対象にする
FILE_PATTERNS          = *.hpp *.cpp *.h *.c

# snippet タグのソース探索パス（@snippet が参照するテストファイルの場所）
EXAMPLE_PATH           = tests/unit/spi-hal \
                         tests/unit/libsensor \
                         tests/unit/libadxl345
EXAMPLE_RECURSIVE      = NO

# 未ドキュメントのものも出力する（学習用に全部見たい場合は YES）
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# HTML出力
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
HTML_EXTRA_STYLESHEET  = docs/assets/doxygen-awesome.css

# Markdown を README として取り込む
USE_MDFILE_AS_MAINPAGE = README.md
INPUT                 += README.md \
                         docs/wiki/release-matrix.md

# LaTeX/PDF は無効（pandocで代替する）
GENERATE_LATEX         = NO

# UMLクラス図（dot が入っていれば自動生成）
HAVE_DOT               = YES
UML_LOOK               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg

# 警告を厳しくする（ドキュメント漏れを検出）
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = docs/doxygen/doxygen-warnings.log
